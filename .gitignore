# .gitignore for C++ Project

# Build directories
build/
cmake-build-*/
out/

# Visual Studio
.vs/
*.vcxproj.user
*.suo
*.sdf
*.opensdf
*.db
*.opendb
*.VC.db
*.VC.VC.opendb

# Visual Studio Code
.vscode/
*.code-workspace

# CLion
.idea/
cmake-build-debug/
cmake-build-release/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Python (for Tool directory)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
.pytest_cache/

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Package files
*.tar.gz
*.zip
*.7z
